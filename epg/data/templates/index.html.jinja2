<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{{ title }}</title>
    <style>
        :root {
            --primary-color: #1a73e8;
            --primary-light: #e8f0fe;
            --primary-dark: #1557b0;
            --bg-color: #f0f2f5;
            --card-bg: #ffffff;
            --text-main: #1f2937;
            --text-secondary: #4b5563;
            --text-muted: #9ca3af;
            --border-color: #e5e7eb;
            --hover-bg: #f9fafb;
            --border-radius: 12px;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
            --shadow: 0 1px 3px rgba(0,0,0,0.06), 0 4px 16px rgba(0,0,0,0.04);
            --shadow-lg: 0 4px 24px rgba(0,0,0,0.08);
        }

        body {
            font-family: 'PingFang SC', 'Microsoft YaHei', -apple-system, sans-serif;
            background-color: var(--bg-color);
            margin: 0;
            padding: 0;
            color: var(--text-main);
            line-height: 1.6;
            -webkit-tap-highlight-color: transparent;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* 頂部導航 */
        .header {
            padding: 36px 20px;
            text-align: center;
            background: var(--card-bg);
            box-shadow: var(--shadow-sm);
            margin-bottom: 28px;
        }

        .header h1 {
            font-size: 32px;
            font-weight: 800;
            margin: 0 0 8px 0;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #1a73e8, #7c3aed);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .update-info {
            font-size: 13px;
            color: var(--text-muted);
            margin: 0;
            display: inline;
        }
        .update-info + .update-info::before {
            content: ' · ';
            color: var(--border-color);
        }
        .update-row {
            margin-bottom: 2px;
        }

        .link-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 18px;
        }

        .cta-button {
            display: inline-flex;
            align-items: center;
            text-decoration: none;
            padding: 8px 18px;
            border-radius: 50px;
            background-color: #fff;
            color: var(--text-secondary);
            border: 1px solid var(--border-color);
            font-size: 13px;
            font-weight: 500;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            box-shadow: var(--shadow-sm);
        }

        .cta-button:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: var(--primary-light);
        }

        /* 主容器 */
        .container {
            display: flex;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px 40px;
            gap: 24px;
        }

        /* 頻道列表側邊欄 */
        .channel-list-container {
            flex: 0 0 260px;
            background: var(--card-bg);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            height: fit-content;
            max-height: 85vh;
            display: flex;
            flex-direction: column;
            position: sticky;
            top: 20px;
            overflow: hidden;
            border: 1px solid var(--border-color);
        }

        .channel-search-container {
            padding: 14px;
            background: #fff;
            border-bottom: 1px solid var(--border-color);
            z-index: 10;
        }

        .channel-search-input {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            font-size: 14px;
            background-color: #f9fafb;
            transition: all 0.2s;
            box-sizing: border-box;
            outline: none;
            color: var(--text-main);
        }

        .channel-search-input:focus {
            background-color: #fff;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(26,115,232,0.12);
        }

        .channel-list {
            flex: 1;
            overflow-y: auto;
            padding: 8px;
        }

        .channel-item {
            padding: 10px 14px;
            margin-bottom: 2px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.15s;
            border-left: 3px solid transparent;
            color: var(--text-secondary);
        }

        .channel-item:hover {
            background-color: var(--hover-bg);
            transform: translateX(2px);
        }

        .channel-item.selected {
            background-color: var(--primary-light);
            color: var(--primary-color);
            font-weight: 600;
            border-left-color: var(--primary-color);
        }

        /* 節目列表清單 */
        .program-list-container {
            flex: 1;
            background: var(--card-bg);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            max-height: 85vh;
            border: 1px solid var(--border-color);
        }

        .date-nav {
            background: #fff;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-color);
            flex-shrink: 0;
        }

        .date-nav p { margin: 0; width: 100%; display: flex; justify-content: space-between; align-items: center; }

        .date-btn {
            padding: 6px 16px;
            border-radius: 20px;
            color: var(--primary-color);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 13px;
            background: var(--primary-light);
        }

        .date-btn:hover { background: #d2e3fc; }
        .date-now {
            font-weight: 700;
            color: var(--text-main);
            font-size: 16px;
            padding-bottom: 2px;
            border-bottom: 2px solid var(--primary-color);
        }

        .program-scroll-area {
            flex: 1;
            overflow-y: auto;
            position: relative;
        }

        .program-list {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .program-item {
            border-bottom: 1px solid #f3f4f6;
            transition: background 0.15s;
        }

        .program-item:hover {
            background: var(--hover-bg);
        }

        .program-item td {
            padding: 15px 16px;
            vertical-align: top;
        }

        .time-cell {
            width: 80px;
            font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;
            font-weight: 600;
            color: var(--text-muted);
            text-align: center;
            background: #f8f9fb;
            font-size: 14px;
        }

        .content-cell {
            padding-left: 20px !important;
        }

        .program-title {
            font-weight: 500;
            font-size: 15px;
            display: block;
            margin-bottom: 2px;
        }

        .program-item.active {
            background-color: #e8f0fe;
            box-shadow: inset 3px 0 0 var(--primary-color);
        }

        .program-item.active:hover {
            background-color: #d2e3fc;
        }

        .now-playing-tag {
            display: inline-block;
            background: var(--primary-color);
            color: white;
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 6px;
            margin-right: 6px;
            vertical-align: middle;
            animation: pulse 2s infinite;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        @keyframes pulse {
            0% { opacity: 0.7; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.05); }
            100% { opacity: 0.7; transform: scale(1); }
        }

        /* 自定義滾動條 */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-thumb { background: #d0d5dd; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #b0b7c3; }
        ::-webkit-scrollbar-track { background: transparent; }

        /* 響應式佈局 */
        @media (max-width: 768px) {
            body, html { height: 100dvh; overflow: hidden; }
            body { display: flex; flex-direction: column; }
            .header { flex-shrink: 0; }
            .container {
                flex: 1; min-height: 0;
                flex-direction: column;
                padding: 0; gap: 0;
                position: relative;
            }
            .header { padding: 14px 12px; margin-bottom: 0; position: static; }
            .header h1 { font-size: 20px; margin-bottom: 6px; }
            .link-container { margin-top: 10px; gap: 8px; }
            .cta-button { font-size: 12px; padding: 6px 12px; }
            /* Mobile toolbar */
            .mobile-toolbar {
                display: flex; align-items: center; gap: 10px;
                padding: 8px 12px; background: #fff;
                border-bottom: 1px solid var(--border-color); flex-shrink: 0;
            }
            .toggle-btn {
                padding: 6px 14px; border-radius: 8px; background: var(--primary-light);
                border: 1px solid transparent; font-size: 13px; cursor: pointer;
                white-space: nowrap; color: var(--primary-color); font-weight: 600;
            }
            .current-channel-label {
                font-size: 14px; font-weight: 600; color: var(--text-main);
            }
            /* Dropdown channel panel */
            .channel-overlay {
                display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
                background: rgba(0,0,0,0.2); z-index: 90;
            }
            .channel-overlay.show { display: block; }
            .channel-list-container {
                display: none; flex-direction: column;
                position: absolute; top: 42px; left: 0; right: 0;
                max-height: 60vh; overflow-y: auto;
                z-index: 100;
                box-shadow: 0 12px 32px rgba(0,0,0,0.12);
                border-radius: 0 0 14px 14px;
                border: none;
            }
            .channel-list-container.open { display: flex; }
            .channel-search-container {
                position: sticky; top: 0; z-index: 10;
            }
            .channel-list {
                flex: none;
                overflow-y: visible;
            }
            .program-list-container {
                flex: 1; max-height: none; border-radius: 0; box-shadow: none; border: none;
            }
            .time-cell { width: 60px; font-size: 13px; }
        }
        /* Desktop: hide mobile toolbar */
        .mobile-toolbar { display: none; }
        @media (max-width: 768px) {
            .mobile-toolbar { display: flex; }
        }

        /* 成功彈窗 */
        .copy-success {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(30, 30, 30, 0.9);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            color: #fff;
            padding: 10px 24px;
            border-radius: 50px;
            font-size: 14px;
            z-index: 1000;
            animation: slideUp 0.3s ease-out;
        }

        @keyframes slideUp {
            from { transform: translate(-50%, 20px); opacity: 0; }
            to { transform: translate(-50%, 0); opacity: 1; }
        }

        .hidden { display: none !important; }
        .url-input { position: absolute; left: -9999px; }
    </style>
</head>

<body>
    <div class="header">
        <h1>{{ title }}</h1>
        <div class="update-info">已更新 {{ num_refresh_channels }}/{{ num_channels }} 個頻道</div>
        <div class="update-info">上次更新：{{ last_update_time }} | 下次更新：{{ next_update_time }}</div>
        
        <div class="link-container">
            <button class="cta-button" id="copyEpgUrlButton">TVXML 鏈接</button>
            <button class="cta-button" id="copyDiypUrlButton">DIYP 接口</button>
            <a href="https://github.com/riverscn/epghub" class="cta-button" target="_blank">GitHub</a>
        </div>

        <input type="text" value="/epg.xml" id="epgUrl" class="url-input" readonly />
        <input type="text" value="/diyp?ch=&date=" id="diypUrl" class="url-input" readonly />
    </div>

    <div class="container">
        <!-- 手機端頻道下拉遮罩 -->
        <div class="channel-overlay" id="channelOverlay" onclick="closeChannelPanel()"></div>
        <!-- 手機端工具欄 -->
        <div class="mobile-toolbar">
            <button class="toggle-btn" onclick="toggleChannelPanel()">☰ 頻道</button>
            <span class="current-channel-label" id="currentChannelLabel">{{ first_channel }}</span>
        </div>
        <!-- 頻道選擇區 -->
        <aside class="channel-list-container" id="channelPanel">
            <div class="channel-search-container">
                <input type="text" id="channelSearch" placeholder="搜索頻道名稱..." class="channel-search-input">
            </div>
            <div class="channel-list">
                <div class="channel-item selected" data-channel="{{ first_channel }}">{{ first_channel }}</div>
                {% for channel in channel_list %}
                <div class="channel-item" data-channel="{{ channel }}">{{ channel }}</div>
                {% endfor %}
            </div>
        </aside>

        <!-- 節目列表區 -->
        <main class="program-list-container">
            <div class="date-nav">
                <p>
                    <span class="date-btn" id="prevDate">← 前一天</span>
                    <span class="date-now" id="currentDate">---- -- --</span>
                    <span class="date-btn" id="nextDate">後一天 →</span>
                </p>
            </div>
            <div class="program-scroll-area" id="programScrollArea">
                <table class="program-list">
                    <tbody id="programBody">
                        <!-- JS 動態加載 -->
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <script>
        function refreshProgramList(channelName, formattedDate, shouldScroll = true) {
            const programBody = document.getElementById('programBody');
            const scrollArea = document.getElementById('programScrollArea');
            const apiUrl = `/diyp?ch=${encodeURIComponent(channelName)}&date=${formattedDate}`;

            programBody.innerHTML = '<tr><td colspan="2" style="text-align:center;padding:40px;color:#999">加載中...</td></tr>';

            fetch(apiUrl)
                .then(response => response.json())
                .then(data => {
                    programBody.innerHTML = '';
                    const now = new Date();

                    if (data.epg_data && data.epg_data.length > 0) {
                        const sorted = data.epg_data.sort((a, b) => a.start.localeCompare(b.start));

                        sorted.forEach(program => {
                            const tr = document.createElement('tr');
                            tr.className = 'program-item';

                            const pStart = new Date(`${formattedDate}T${program.start}{{timezone_offset}}`);
                            const pEnd = new Date(`${formattedDate}T${program.end}{{timezone_offset}}`);
                            if (pEnd < pStart) pEnd.setDate(pEnd.getDate() + 1);

                            const isActive = now >= pStart && now <= pEnd;
                            if (isActive) tr.classList.add('active');

                            tr.innerHTML = `
                                <td class="time-cell">${program.start}</td>
                                <td class="content-cell">
                                    <span class="program-title">
                                        ${isActive ? '<span class="now-playing-tag">LIVE</span>' : ''}
                                        ${program.title}
                                    </span>
                                    ${program.desc ? `<span class="program-desc" style="font-size:12px;color:#888">${program.desc}</span>` : ''}
                                </td>
                            `;
                            programBody.appendChild(tr);
                        });
                        
                        if (shouldScroll) {
                            const activeItem = document.querySelector('.program-item.active');
                            if (activeItem) {
                                setTimeout(() => {
                                    
                                    const topPos = activeItem.offsetTop;
                                    scrollArea.scrollTo({
                                        top: topPos - 50,
                                        behavior: 'smooth'
                                    });
                                }, 300);
                            }
                        }
                    } else {
                        programBody.innerHTML = '<tr><td colspan="2" style="text-align:center;padding:40px;color:#999">暫無節目數據</td></tr>';
                    }
                })
                .catch(() => {
                    programBody.innerHTML = '<tr><td colspan="2" style="text-align:center;padding:40px;color:#f44336">數據加載失敗</td></tr>';
                });
        }

        function toggleChannelPanel() {
            document.getElementById('channelPanel').classList.toggle('open');
            document.getElementById('channelOverlay').classList.toggle('show');
        }
        function closeChannelPanel() {
            document.getElementById('channelPanel').classList.remove('open');
            document.getElementById('channelOverlay').classList.remove('show');
        }

        function init() {
            const channelItems = document.querySelectorAll('.channel-item');
            const searchInput = document.getElementById('channelSearch');

            searchInput.addEventListener('input', (e) => {
                const term = e.target.value.toLowerCase();
                channelItems.forEach(item => {
                    item.classList.toggle('hidden', !item.textContent.toLowerCase().includes(term));
                });
            });

            channelItems.forEach(item => {
                item.addEventListener('click', () => {
                    channelItems.forEach(i => i.classList.remove('selected'));
                    item.classList.add('selected');
                    document.getElementById('currentChannelLabel').textContent = item.textContent;
                    // 手機端選擇後關閉下拉
                    if (window.innerWidth <= 768) {
                        closeChannelPanel();
                    }
                    goBackToday();
                });
            });

            const copy = (id) => {
                const el = document.getElementById(id);
                el.select();
                document.execCommand('copy');
                const toast = document.createElement('div');
                toast.className = 'copy-success';
                toast.textContent = '✅ 已複製鏈接';
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 2000);
            };

            document.getElementById('copyEpgUrlButton').onclick = () => copy('epgUrl');
            document.getElementById('copyDiypUrlButton').onclick = () => copy('diypUrl');

            const base = window.location.origin;
            document.getElementById('epgUrl').value = base + '/epg.xml';

            document.getElementById('prevDate').onclick = () => moveDate(-1);
            document.getElementById('nextDate').onclick = () => moveDate(1);

            goBackToday(true); 
        }

        function updateDiypUrl(channel, date) {
            document.getElementById('diypUrl').value = window.location.origin + '/diyp?ch=' + encodeURIComponent(channel) + '&date=' + date;
        }

        function moveDate(days) {
            const parts = document.getElementById('currentDate').textContent.split('-');
            const y = parseInt(parts[0]), m = parseInt(parts[1]) - 1, d = parseInt(parts[2]);
            const date = new Date(y, m, d);
            date.setDate(date.getDate() + days);
            const ny = date.getFullYear();
            const nm = String(date.getMonth() + 1).padStart(2, '0');
            const nd = String(date.getDate()).padStart(2, '0');
            updateView(`${ny}-${nm}-${nd}`, true);
        }

        function getLocalDateStr() {
            const now = new Date();
            const offset = "{{timezone_offset}}";
            const hours = parseInt(offset.substring(1,3));
            now.setHours(now.getHours() + (offset[0] === '+' ? 1 : -1) * hours);
            const y = now.getFullYear();
            const m = String(now.getMonth() + 1).padStart(2, '0');
            const d = String(now.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function goBackToday(shouldScroll = true) {
            updateView(getLocalDateStr(), shouldScroll);
        }

        function updateView(dateStr, shouldScroll) {
            document.getElementById('currentDate').textContent = dateStr;
            const sel = document.querySelector('.channel-item.selected');
            if (sel) {
                refreshProgramList(sel.dataset.channel, dateStr, shouldScroll);
                updateDiypUrl(sel.dataset.channel, dateStr);
            }
        }

        window.onload = init;
    </script>
</body>
</html>
